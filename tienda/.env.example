# URL de la API. En desarrollo, si se omite, se usa http://localhost:5000/api.
# En producción (build) debe ser /api si el backend sirve el frontend.
VITE_API_URL=http://localhost:5000/api

# URL del panel de administración (para el link después del registro).
VITE_PANEL_URL=http://localhost:5173

# Clave pública de Cloudflare Turnstile para el formulario de registro.
# Si está vacía, el captcha no se muestra.
VITE_TURNSTILE_SITE_KEY=
